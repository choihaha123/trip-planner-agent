# .env.example — 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git 에 올리지 않는다)

# Amazon Bedrock 자격 증명 (필수)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# 답변(에이전트) 기본 모델 ID와 리전 (선택, 비우면 src/config.py 기본값: Sonnet 4.5 @us-west-2)
# 리전은 AWS_DEFAULT_REGION(임베딩·판정 모델용)과 따로 정한다.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_MODEL_REGION=us-west-2

# 기본 모델이 토큰 한도(ThrottlingException)에 걸리면 순서대로 쓸 대체 모델 (선택, "모델ID@리전" 쉼표 구분)
# 비우면 src/config.py 기본 목록 사용: Sonnet 4.5를 global(us-east-1) → global(ap-northeast-2), 다음 Sonnet 4.6(us → global), Haiku 4.5
# BEDROCK_FALLBACK_MODELS=global.anthropic.claude-sonnet-4-5-20250929-v1:0@us-east-1,us.anthropic.claude-sonnet-4-6@us-east-1
# BEDROCK_MAX_RETRIES=1               # 판정 모델(Haiku) 재시도 횟수
# BEDROCK_READ_TIMEOUT=180            # 답변 모델 응답 대기 한도(초). 긴 일정표 생성은 60초를 넘는다
# BEDROCK_AGENT_MAX_RETRIES=0         # 답변 모델 재시도 횟수(시간 초과를 다시 기다리지 않음, 한도 초과는 대체 모델로)
# ITINERARY_MAX_SEARCH_ROUNDS=2       # 일정표 요청의 검색 라운드 상한(넘으면 일정표 작성으로 넘어감)
# AGENT_MAX_MODEL_CALLS_PER_TURN=25   # 한 턴의 모델 호출 상한(넘으면 안내 문구로 그 턴을 끝냄)
# ITINERARY_MAX_RENDER_ATTEMPTS=3     # 한 턴에서 일정표 렌더링 실패 허용 횟수(넘으면 글로 사유를 답함)
# (예산 조정안 기준 15%는 src/config.py BUDGET_ADJUSTMENT_THRESHOLD)

# URL 관련도 판정 모델 (선택, 기본 Haiku 4.5 @us-east-1) 과 한도 초과 시 대체 모델
# RELEVANCE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0@us-east-1
# RELEVANCE_FALLBACK_MODELS=us.anthropic.claude-haiku-4-5-20251001-v1:0@us-west-2,global.anthropic.claude-haiku-4-5-20251001-v1:0@us-east-1

# 대화 기록 DB 경로 (선택, 기본 storage/checkpoints.sqlite)
# CHECKPOINT_DB=storage/checkpoints.sqlite

# 장기 기억 DB 경로 (선택, 기본 storage/memory.sqlite)
# MEMORY_DB=storage/memory.sqlite

# 웹 (선택): 계정·세션·대화 목록 DB, 로그인 유지 일수, 비밀번호 최소 길이, HTTPS 배포 시 쿠키 secure
# WEB_DB=storage/web.sqlite
# WEB_SESSION_DAYS=14
# PASSWORD_MIN_LENGTH=8
# WEB_COOKIE_SECURE=false
# WEB_MESSAGE_MAX_CHARS=4000
# 서버 전체에서 동시에 만드는 답변 수 (넘으면 '잠시 기다리는 중', Bedrock 한도 보호)
# WEB_MAX_CONCURRENT_RUNS=4

# 임베딩 모델 (선택, 기본 Bedrock Titan V2)
# EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# 벡터DB(Chroma) 저장 폴더 (선택, 기본 storage/chroma)
# CHROMA_DIR=storage/chroma

# 시간대 (선택, 기본 Asia/Seoul)
# APP_TIMEZONE=Asia/Seoul

# 로그 파일 경로 (선택, 기본 logs/app.jsonl)
# LOG_FILE=logs/app.jsonl
# LOG_LEVEL=INFO
# 실행 추적(LLM·도구 호출) 기록 경로 (선택, 기본 logs/trace.jsonl)
# TRACE_LOG_FILE=logs/trace.jsonl

# Tavily 웹 검색 API 키 (Step 5부터 필요)
# TAVILY_API_KEY=

# 링크 수집: 내부망·로컬 주소 차단의 예외 (선택, 기본 비움 = 모두 차단. host 또는 host:port, 쉼표 구분)
# 평가 스크립트는 로컬 테스트 페이지(127.0.0.1:8765)를 실행 중에만 스스로 허용하므로 여기 넣을 필요가 없다. 배포 시에는 비워 둔다.
# COLLECT_ALLOWED_HOSTS=

# MCP 서버(Claude Desktop 등)로 쓸 때의 고정 사용자 ID (선택, 기본 mcp_user)
# 대화로는 바꿀 수 없다. CLI 사용자와 저장 링크·기억을 함께 쓰려면 그 이름을 넣는다(예: alice).
# MCP_USER_ID=mcp_user
