# .env.example — 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git 에 올리지 않는다)

# Amazon Bedrock 자격 증명 (필수)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Bedrock 모델 ID (선택, 비우면 src/config.py 기본값 사용)
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# 기본 모델이 토큰 한도(ThrottlingException)에 걸리면 순서대로 쓸 대체 모델 (선택, "모델ID@리전" 쉼표 구분)
# 비우면 src/config.py 기본 목록 사용: 같은 Sonnet 4.5를 us-west-2 → global(us-east-1) → global(ap-northeast-2), 다음 Sonnet 4.6, Haiku 4.5
# BEDROCK_FALLBACK_MODELS=us.anthropic.claude-sonnet-4-5-20250929-v1:0@us-west-2,us.anthropic.claude-sonnet-4-6@us-east-1
# BEDROCK_MAX_RETRIES=1

# URL 관련도 판정 모델 (선택, 기본 Haiku 4.5 @us-east-1) 과 한도 초과 시 대체 모델
# RELEVANCE_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0@us-east-1
# RELEVANCE_FALLBACK_MODELS=us.anthropic.claude-haiku-4-5-20251001-v1:0@us-west-2,global.anthropic.claude-haiku-4-5-20251001-v1:0@us-east-1

# 대화 기록 DB 경로 (선택, 기본 storage/checkpoints.sqlite)
# CHECKPOINT_DB=storage/checkpoints.sqlite

# 임베딩 모델 (선택, 기본 Bedrock Titan V2)
# EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# 벡터DB(Chroma) 저장 폴더 (선택, 기본 storage/chroma)
# CHROMA_DIR=storage/chroma

# 시간대 (선택, 기본 Asia/Seoul)
# APP_TIMEZONE=Asia/Seoul

# 로그 파일 경로 (선택, 기본 logs/app.jsonl)
# LOG_FILE=logs/app.jsonl
# LOG_LEVEL=INFO
# 실행 추적(LLM·도구 호출) 기록 경로 (선택, 기본 logs/trace.jsonl)
# TRACE_LOG_FILE=logs/trace.jsonl

# Tavily 웹 검색 API 키 (Step 5부터 필요)
# TAVILY_API_KEY=
